    "dompurify": "^3.3.0",
    "eslint": "8.38.0",
    "eslint-config-next": "13.3.0",
    "js-cookie": "^3.0.5",
    "less": "^4.1.3",
    "less-loader": "^11.1.0",
    "next": "13.3.0",
    "next-with-less": "^2.0.5",
    "react": "18.2.0",
    "react-animation-on-scroll": "^5.1.0",
    "react-dom": "18.2.0",
